// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  password    String
  countryCode String
  phone       String
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  resume      Resume?
  updatedAt   DateTime @updatedAt

  @@index([id])
}

model Resume {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique // One resume per user

  // Cloud Storage Information
  fileUrl       String? // Full cloud URL (S3/Cloudinary/etc)
  fileName      String // Original filename
  fileSize      Int // Size in bytes
  fileMimeType  String // MIME type (application/pdf, etc)
  storageKey    String? // Storage key/path for deletion
  storageBucket String? // Bucket name (for S3)

  // Processing Status
  processingStatus   ProcessingStatus @default(PENDING)
  processingError    String? // Error message if failed
  processingProgress Int              @default(0) // 0-100

  // Analysis Results (stored as JSON)
  atsScore        Int? // ATS compatibility score (0-100)
  analysisData    Json? // Complete analysis results
  skillsExtracted String[] // Array of extracted skills
  experienceYears Float? // Years of experience detected
  suggestions     Json? // Improvement suggestions

  // Structured Parsed Data
  parsedData      Json? // Full structured output (ParsedResume type)
  rawText         String? // Cleaned extracted text
  confidenceScore Float? // Overall confidence 0.0–1.0
  parsingMethod   String? // "regex_only" | "llm_only" | "hybrid"

  // Timestamps
  uploadedAt  DateTime  @default(now())
  processedAt DateTime? // When processing completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([processingStatus])
  @@index([uploadedAt])
}

enum Role {
  USER
  ADMIN
}

enum ProcessingStatus {
  PENDING // Uploaded, waiting to process
  PROCESSING // Currently being analyzed
  COMPLETED // Successfully processed
  FAILED // Processing failed
}
